{
  "manifest_version": 3,
  "name": "ALPAR AI - Report AI Failures",
  "version": "1.0.0",
  "description": "Report AI hallucinations and failures directly from ChatGPT, Claude, and Gemini.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ]
}
