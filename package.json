{
  "name": "alpar-ai",
  "version": "1.0.0",
  "private": true,
  "description": "ALPAR AI — Trust infrastructure for AI accountability. Community-driven incident reporting platform.",
  "license": "AGPL-3.0",
  "author": "ALPAR AI Team",
  "homepage": "https://alparai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantummatrixcore-lab/Alparai.com.git"
  },
  "keywords": [
    "ai",
    "incident",
    "reporting",
    "trust",
    "safety",
    "accountability",
    "transparency"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "validate": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.10",
    "@marsidev/react-turnstile": "^1.5.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.15",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "knip": "^5.40.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
