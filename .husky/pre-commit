guarded=$(git diff --cached --name-only | grep -E '^(docs/MASTER_PLAN\.md|\.husky/|\.github/workflows/plan-guard\.yml|[^/]+\.md)$' | grep -vE '^(README|CLAUDE|AGENTS)\.md$' || true)
if [ -n "$guarded" ]; then
  author_name=$(git config user.name)
  case "$author_name" in
    "Claude"|"Opus"|"Fable"|"Sonnet")
      # Architect identity verified
      ;;
    *)
      echo "BLOCKED by plan-guard (Rule #35): Architect-only paths cannot be edited by Executor." >&2
      echo "Identity '$author_name' is not on the Architect allowlist (Claude, Opus, Fable, Sonnet)." >&2
      echo "$guarded" | sed 's/^/  - /' >&2
      exit 1
      ;;
  esac
fi
npx lint-staged
python -m graphify update . 2>/dev/null || true
