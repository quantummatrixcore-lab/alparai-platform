guarded=$(git diff --cached --name-only | grep -E '^(docs/MASTER_PLAN\.md|\.husky/|\.github/workflows/plan-guard\.yml|[^/]+\.md)$' | grep -vE '^(README|CLAUDE|AGENTS)\.md$' || true)
if [ -n "$guarded" ]; then
  if [ "$ARCHITECT" != "1" ]; then
    echo "BLOCKED by plan-guard (Rule #14 / #35): Architect-only paths cannot be edited by Executor." >&2
    echo "$guarded" | sed 's/^/  - /' >&2
    exit 1
  fi
  author_email=$(git config user.email)
  case " noreply@anthropic.com " in
    *" $author_email "*) ;;
    *)
      echo "BLOCKED by plan-guard (Rule #35): ARCHITECT=1 is set but git identity '$author_email' is not on the Architect allowlist." >&2
      echo "The [architect] marker / env flag without a matching identity is itself a violation. CI enforces the same check." >&2
      exit 1
      ;;
  esac
fi
npx lint-staged
python -m graphify update . 2>/dev/null || true
