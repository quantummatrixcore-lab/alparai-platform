{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/deploy-gate.mjs",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "pnpm build",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "trailingSlash": false,
  "cleanUrls": true,
  "github": {
    "silent": false,
    "autoAlias": true
  },
  "crons": [
    {
      "path": "/api/cron/translate-backfill",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cost-alarm",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/import-incidents?source=aiaaic",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/import-incidents?source=aiid",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/fetch-external",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/process-deletions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/hard-delete",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/generate-marketing",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/retro-audit",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/kill-metric",
      "schedule": "0 8 9 8 *"
    },
    {
      "path": "/api/cron/pivot-check",
      "schedule": "0 8 1 9 *"
    },
    {
      "path": "/api/cron/k-provider-preview",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/k-weekly-refresh",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/k-model-retirement",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/moderation-sla-alarm",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 10 * * 1"
    }
  ]
}
