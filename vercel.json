{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/deploy-gate.mjs",
  "framework": "nextjs",
  "regions": ["fra1"],
  "buildCommand": "pnpm build",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "trailingSlash": false,
  "cleanUrls": true,
  "github": {
    "silent": false,
    "autoAlias": true
  },
  "crons": []
}
