{
  "autoFix": {
    "critical": {
      "enabled": true,
      "createPR": true,
      "requireReview": true,
      "categories": ["security", "data-loss", "breaking-bug"]
    },
    "high": {
      "enabled": true,
      "createPR": true,
      "requireReview": true,
      "categories": ["performance", "major-refactor"]
    },
    "medium": {
      "enabled": false,
      "createIssue": true,
      "addToBacklog": true
    },
    "low": {
      "enabled": false,
      "logOnly": true
    }
  },
  "thresholds": {
    "minConfidence": 0.75,
    "consensusRequired": 2,
    "maxFilesPerPR": 10
  }
}
